# Copy to .env and fill in real values. Never commit the real .env.

# --- Postgres container credentials (used by the postgres service itself,
# and composed into AICOM_DATABASE_URL below) ---
POSTGRES_USER=aicom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aicom

# --- AICOM_* settings (see src/aicom/config.py) ---

# SQLAlchemy URL the app and Alembic connect with; must match the postgres
# service's credentials/db above when using docker-compose's "postgres" host.
AICOM_DATABASE_URL=postgresql+psycopg://aicom:change-me@postgres:5432/aicom

# Slack bot token used to post approval/reminder messages (xoxb-...).
AICOM_SLACK_BOT_TOKEN=xoxb-replace-me

# Slack app signing secret, used to verify POST /slack/interactions requests.
AICOM_SLACK_SIGNING_SECRET=replace-me

# Slack channel ID (or name) approval/reminder messages are posted to.
AICOM_SLACK_CHANNEL=C0000000000

# JSON array of Slack user IDs allowed to approve/reject gated actions.
AICOM_SLACK_APPROVER_IDS=["U0000000000"]

# Directory where per-run agent workspaces are checked out; mount a volume
# here if you want them to survive container restarts.
AICOM_WORKSPACE_ROOT=/app/workspaces

# Directory agent-produced artifacts are written to.
AICOM_ARTIFACT_REPO_PATH=/app/artifacts

# Name/path of the Claude Code CLI binary the worker subprocesses.
AICOM_CLAUDE_BINARY=claude

# Seconds the worker sleeps between ticks when there is no queued work.
AICOM_WORKER_POLL_SECONDS=2.0

# Seconds between heartbeat refreshes on a run the worker is executing.
AICOM_WORKER_HEARTBEAT_SECONDS=15.0

# Console login. An empty password locks the console entirely.
AICOM_CONSOLE_PASSWORD=change-me
# Signs the session cookie. Change this and every session is invalidated.
AICOM_SESSION_SECRET=change-me-too
# Leave false while serving plain HTTP; turn on together with TLS.
AICOM_SESSION_COOKIE_SECURE=false
# How often the console recomputes and pushes a delta, in seconds.
AICOM_SSE_INTERVAL_SECONDS=10
